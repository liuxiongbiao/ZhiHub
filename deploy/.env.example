# deploy/.env.example —— 复制为 .env 后按环境覆盖
# 生产环境必须显式设置以下全部凭据，禁止沿用默认值。

# 应用
APP_ENV=development
APP_SECRET_KEY=change-me

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=zhihub
MYSQL_PASSWORD=zhihub
MYSQL_DATABASE=zhihub
MYSQL_ROOT_PASSWORD=root

# MongoDB
MONGO_URI=mongodb://mongo:27017/zhihub

# Redis / RabbitMQ
REDIS_HOST=redis
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Milvus / Elasticsearch
MILVUS_HOST=milvus
ELASTICSEARCH_URL=http://elasticsearch:9200

# MinIO（Milvus 依赖）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_DB_NAME=langfuse
CLICKHOUSE_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
LANGFUSE_NEXTAUTH_SECRET=langfuse-demo-secret-2026
LANGFUSE_SALT=langfuse-demo-salt-2026
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse:3000

# LLM / Embedding
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=

# 支付宝 / 微信 / OCR（留空走 mock 降级，生产必须配置）
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
OCR_API_KEY=
OCR_SECRET_KEY=
