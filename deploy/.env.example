# deploy/.env.example —— 复制为 .env 后按环境覆盖
# 生产环境必须显式设置以下全部凭据，禁止沿用默认值。

# 应用
APP_ENV=development
DEMO_QUICK_LOGIN_ENABLED=false
APP_SECRET_KEY=change-me
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# 开发环境是否回显验证码/激活链接（生产必须 false；仅本机联调用）
DEV_ALLOW_CODE_REVEAL=false

# 平台运营令牌（P0-6：企业版审批专用，勿与业务账号混用）
PLATFORM_OPS_TOKEN=change-me-ops-token

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=zhihub
MYSQL_PASSWORD=zhihub
MYSQL_DATABASE=zhihub
MYSQL_ROOT_PASSWORD=root

# MongoDB
MONGO_URI=mongodb://mongo:27017/zhihub

# Redis（P2-1：强制认证，生产必须更换）
REDIS_HOST=redis
REDIS_PASSWORD=zhihub-dev

# RabbitMQ（P2-1：强制认证，生产必须更换）
RABBITMQ_USER=zhihub
RABBITMQ_PASS=zhihub-dev

# Milvus / Elasticsearch
MILVUS_HOST=milvus
ELASTICSEARCH_URL=http://elasticsearch:9200

# MinIO（Milvus 依赖）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 可观测性（默认不部署 langfuse；如需本地部署:
#   docker compose --profile observability up -d
# 或直接使用云 Langfuse 的 key 指向云端）
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_DB_NAME=langfuse
CLICKHOUSE_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
LANGFUSE_NEXTAUTH_SECRET=langfuse-demo-secret-2026
LANGFUSE_SALT=langfuse-demo-salt-2026
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse:3000

# LLM / Embedding
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=
DEEP_AGENT_TIMEOUT_SECONDS=600
DEEP_AGENT_TOKEN_BUDGET=500000

# 支付宝 / 阿里云短信 / 微信 / OCR（留空走 mock 降级，生产启用时必须配置）
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TIMEOUT_SECONDS=2.8
WECHAT_APP_ID=
WECHAT_APP_SECRET=
OCR_API_KEY=
OCR_SECRET_KEY=

# 邮箱激活（P0-5：生产必须配置 SMTP，否则拒绝启动）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 计费决策（2026-08-12：试用免费但超额计费；定价按 PRD）
BILLING_CHARGE_TRIAL=true
BILLING_OVERAGE_PRICE=0.5
BILLING_PLAN_BASE_FEES={"trial": 0, "basic": 999, "pro": 4999, "enterprise": 0}
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_STORAGE_DIR=/data/uploads
TENANT_CANCELLATION_RETENTION_DAYS=30
WS_PUBSUB_CHANNEL=zhihub:ws:broadcast

# 外部功能开关；production 中启用即要求完整配置。
PAYMENT_ENABLED=false
SMS_ENABLED=false
WECHAT_ENABLED=false
EMAIL_ENABLED=false
LLM_ENABLED=false
EMBEDDING_ENABLED=false
EMAIL_VERIFY_REQUIRED=true
EMAIL_VERIFY_LINK_BASE=http://localhost:5173
INVITE_LINK_BASE=http://localhost:5173/accept-invite

# RagFlow 语义解析（PRD 3.2）：配置后走 RagFlow；未配置/失败自动降级本地解析
# RAGFLOW_BASE_URL=http://ragflow:9380
# RAGFLOW_API_KEY=
# RAGFLOW_EMAIL=
# RAGFLOW_PASSWORD=
# RAGFLOW_DATASET_ID=
# RAGFLOW_PARSE_TIMEOUT_SECONDS=300

# P0-2 Widget 嵌入代码公共基地址（含 scheme，不带尾斜杠）
# 生产必须配置为对外可访问域名（如 https://chat.yourdomain.com），缺失时生成嵌入代码接口报 409；
# development 环境默认回退 http://localhost:5173
# PUBLIC_BASE_URL=https://chat.yourdomain.com
