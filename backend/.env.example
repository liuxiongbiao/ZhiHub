# backend/.env.example
# 职责: 环境变量模板，复制为 .env 使用，不入库
# 分工: 🟢 弱模型可独立完成
# 对应日程: Day 1

APP_ENV=development
APP_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=zhihub
MYSQL_PASSWORD=zhihub
MYSQL_DATABASE=zhihub

MONGO_URI=mongodb://localhost:27017/zhihub

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

MILVUS_HOST=localhost
MILVUS_PORT=19530

ELASTICSEARCH_URL=http://localhost:9200

# LLM 网关（DeepSeek 优先，可切换）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Embedding/Rerank（简化方案：使用云端API，不自建GPU RagFlow服务）
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── 可选外部服务（不填则对应功能走 mock/降级模式，详见 docs/api-keys-guide.md）──

# 支付宝沙箱支付（PRD 3.10；不填 -> mock 模式，仅生成沙箱跳转 URL，回调验签不可用）
# 获取：支付宝开放平台 -> 沙箱应用（https://open.alipay.com/develop/sandbox/app）
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 微信公众号网页授权（PRD 3.1 微信扫码登录；不填 -> mock 模式，openid 为假值）
# 获取：微信公众平台 -> 设置与开发 -> 基本配置（AppID/AppSecret），需已认证公众号
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 百度 OCR（PRD 3.2 扫描件/图片 PDF 识别；不填 -> mock 模式，扫描件上传会报"无法识别"）
# 获取：百度智能云 -> 文字识别 -> 创建应用（https://console.bce.baidu.com/ai/#/ai/ocr/overview/index）
OCR_API_KEY=

# ── 可观测性（可选；不填则 Langfuse 降级 no-op）──
# 获取：Langfuse Cloud（https://cloud.langfuse.com）或自托管
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Agent 工具模式：mcp（默认）| fc（Function Calling 对比）
AGENT_TOOL_MODE=mcp
